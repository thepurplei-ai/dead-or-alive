# Edge Function secrets. Set them with:  npx supabase secrets set --env-file supabase/functions/.env
# NEVER commit the real file and NEVER put these in the mobile app.
OPENAI_API_KEY=
# Model IDs: copy current IDs from the provider docs (they change often).
OPENAI_DIRECTOR_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_MODERATION_MODEL=omni-moderation-latest
RUNWAYML_API_SECRET=
RUNWAY_IMAGE_TO_VIDEO_MODEL=
RUNWAY_VIDEO_TO_VIDEO_MODEL=
RUNWAY_API_VERSION=2024-11-06
# Long random string; also used in supabase/cron.sql
WORKER_SECRET=
# Later, for Google Play Billing:
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
